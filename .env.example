# Copy to .env.local and fill in. NEVER commit .env.local.

# --- RPC / Data providers ---
ALCHEMY_API_KEY=
CDP_API_KEY=
CDP_API_SECRET=
BASESCAN_API_KEY=

# --- Auth / Session ---
SIWE_SESSION_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Cache ---
REDIS_URL=redis://localhost:6379
CACHE_SERVICE_URL=http://localhost:4000
CACHE_PORT=4000
INTERNAL_API_TOKEN=

# --- Chain config ---
NEXT_PUBLIC_DEFAULT_CHAIN=base-sepolia
NEXT_PUBLIC_BASE_MAINNET_RPC=
NEXT_PUBLIC_BASE_SEPOLIA_RPC=

# --- Public site URL (required: metadataBase + share/OG links resolve against this) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Wallet connectors (Base Account always works; this is optional, only needed for
#     WalletConnect-paired mobile wallets. Free project id from cloud.reown.com. ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Contracts (filled in after deploy) ---
NEXT_PUBLIC_PORTFOLIO_SNAPSHOT_ADDRESS_SEPOLIA=
NEXT_PUBLIC_PORTFOLIO_SNAPSHOT_ADDRESS_MAINNET=

# --- Builder attribution ---
NEXT_PUBLIC_BUILDER_CODE=

# --- Deploy (NEVER share, NEVER commit) ---
# Loaded from password manager at deploy time, not from this file in CI.
DEPLOYER_PRIVATE_KEY=
