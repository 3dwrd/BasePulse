# Copy to contracts/.env and fill in. NEVER commit contracts/.env.
# NO private key here — the deployer key lives ONLY in an encrypted
# Foundry keystore (see docs/DEPLOY.md). This file holds public config.

# RPC endpoints (public Base RPCs work; swap for CDP/Alchemy if rate-limited)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# BaseScan API key for contract verification (free: https://basescan.org/myapikey)
BASESCAN_API_KEY=
